# Single source of configuration for the whole project: docker compose, Django, Celery and Next.js.
# Copy to .env and adjust. Every variable has a default, so the stack (and CI) also runs with no .env.
# Inside docker, compose points POSTGRES_HOST/REDIS_HOST at its own services; the values below
# are what you'd use from the host machine.

# --- Host ports published by docker compose ---
# Interface the ports bind to. 127.0.0.1 keeps Postgres/Redis/API off your LAN; 0.0.0.0 exposes them.
BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Defaults to http://localhost:${FRONTEND_PORT},http://localhost:${BACKEND_PORT}
# DJANGO_CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO
# Where uploaded and downloaded media files are stored (default: backend/media)
# MEDIA_ROOT=

# --- Auth (JWTs in httpOnly cookies) ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# Set true when served over HTTPS so cookies are only sent securely
AUTH_COOKIE_SECURE=false
# Rate limits: register + login per client address, login per email address, and token refresh per client
AUTH_THROTTLE_RATE=20/min
AUTH_ACCOUNT_THROTTLE_RATE=10/min
AUTH_REFRESH_THROTTLE_RATE=60/min
# Proxies in front of Django that append to X-Forwarded-For (the Next.js /api proxy = 1)
TRUSTED_PROXY_COUNT=1

# --- Local Postgres (docker `db` service; used whenever SUPABASE_DATABASE_URL is empty) ---
POSTGRES_HOST=localhost
POSTGRES_DB=lessoncrafter
POSTGRES_USER=lessoncrafter
POSTGRES_PASSWORD=lessoncrafter
# Seconds a database connection is reused (0 = close after each request)
DB_CONN_MAX_AGE=60

# --- Supabase (optional) ---
# Dashboard → Connect → "Session pooler" (port 5432), with ?sslmode=require. Not the transaction pooler (6543).
# When set, the backend uses Supabase and, on every start, first copies local rows Supabase lacks (insert-only).
SUPABASE_DATABASE_URL=
SYNC_LOCAL_TO_SUPABASE=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PASSWORD=

# --- Frontend (both default to http://localhost:${BACKEND_PORT}; set only to override) ---
# Where the Next.js server proxies /api/* when run on the host (docker compose uses http://backend:8000)
# DJANGO_API_ORIGIN=
# Browser-facing Django URL for Swagger/admin links
# NEXT_PUBLIC_BACKEND_URL=
# Where the console's Learners page links to the Django admin (defaults to ${NEXT_PUBLIC_BACKEND_URL}/admin)
# NEXT_PUBLIC_DJANGO_ADMIN_URL=

# --- LLM providers (the model registry refers to these by name; set the ones you use) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Thinking-token budgets for models whose reasoning is controlled by a budget
LLM_REASONING_BUDGET_LOW=2048
LLM_REASONING_BUDGET_MEDIUM=8192
LLM_REASONING_BUDGET_HIGH=24576

# --- Landing page ---
# Requests per client address per minute for the hero card's random question (a public endpoint)
LANDING_DEMO_THROTTLE_RATE=60/min
# Seconds the list of active question ids is cached (it is also cleared when a question is saved in the admin)
LANDING_DEMO_IDS_TTL_S=600

# --- Console (the staff-only admin API, /api/console) ---
# What one calendar month (UTC) of AI spend should stay under, in US dollars; the overview shows month to date against
# it. Nothing is cut off when it is passed.
CONSOLE_MONTHLY_BUDGET_USD=25
# Requests per staff member per minute
CONSOLE_THROTTLE_RATE=120/min

# --- Onboarding: first-topic suggestions ---
# Suggestion requests per learner per minute (a request can cost a model call, when the catalogue has no match)
TOPIC_SUGGESTIONS_THROTTLE_RATE=30/min
# Seconds a suggested-topics page, a model's topic list and a translation stay in the cache (default 30 days)
ONBOARDING_SUGGESTION_TTL_S=2592000

# --- Lesson flow (phase 3+) ---
# Lessons a learner may start per hour (each one costs model calls)
LESSON_CREATE_THROTTLE_RATE=30/hour
# Test submissions per learner; the open-ended answers of each are graded by a model
TEST_SUBMIT_THROTTLE_RATE=30/hour
# Seconds between keep-alive pings on a lesson's progress stream
SSE_HEARTBEAT_S=15
# Seconds a worker may hold a lesson run without a sign of life; also how long Redis waits before redelivering an
# unacknowledged task. Raise it if one model call (with retries and fallbacks) can take longer than this.
FLOW_RUN_LOCK_TTL_S=600
# The sandbox/ Node package that runs check.mjs and render-check.mjs (default: <repo>/sandbox)
# SANDBOX_DIR=
NODE_BINARY=node
SANDBOX_CHECK_TIMEOUT_S=30
SANDBOX_RENDER_TIMEOUT_S=180
SANDBOX_PAGE_TIMEOUT_MS=8000
# Where lesson media is searched (the public services by default; the offline walk-through points these at a fake)
# WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
# OPENVERSE_API_URL=https://api.openverse.org/v1/images/
# GIPHY_API_URL=https://api.giphy.com/v1/gifs/search
# Downloads are https-only and never to a private address; true only for the offline walk-through's fake media host
MEDIA_ALLOW_PRIVATE_HOSTS=false
# Optional GIF search for the media agent (also add "giphy" to FlowSettings.media_sources)
GIPHY_API_KEY=
# How long signed media URLs (/api/media/{id}?exp=&sig=) stay valid, in seconds
MEDIA_URL_TTL_S=21600

# --- Tracing of model calls (optional) ---
# none (default), langsmith or langfuse. A trace holds the prompts and replies, which contain what the learner wrote,
# so it goes to the service you choose and nowhere else. The keys below are read by the services' SDKs.
LLM_TRACING=none
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=lesson-crafter
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Offline walk-through (optional) ---
# Any non-empty value lets the registry in tests/e2e/fake_registry.json (a fake LLM provider) pass its key check.
# Not a secret. See docs/local-setup.md, "Walk through the app without API keys".
FAKE_LLM_API_KEY=

# --- Browser tests (make e2e / make fake-llm; docs/testing.md) ---
# The throwaway stack has its own ports, so it can run beside `make up`. Its staff user is for the console tests only.
# E2E_FRONTEND_PORT=7100
# E2E_BACKEND_PORT=7110
# E2E_STAFF_EMAIL=staff@example.com
# E2E_STAFF_PASSWORD=E2e-staff-pass-1
